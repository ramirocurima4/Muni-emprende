# Base de datos PostgreSQL local (muniemprende_dev)
DATABASE_URL="postgresql://usuario:password@localhost:5432/muniemprende_dev?schema=public"

# Secreto para firma de JWT en cookies HttpOnly (mínimo 32 caracteres aleatorios)
JWT_SECRET="cambiar_por_un_secreto_aleatorio_seguro_de_al_menos_32_caracteres"

# Directorio físico de almacenamiento local heredado (opcional, fallback dev)
UPLOAD_DIR="./storage/uploads"

# Supabase Storage (bucket público: muniemprende)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_de_supabase"

# URL pública base (para generación de metadatos OpenGraph / WhatsApp)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cuenta maestra Superadmin de la Dirección de Modernización (para prisma/seed.ts)
SUPERADMIN_USERNAME="modernizacion"
SUPERADMIN_PASSWORD="cambiar_por_clave_segura_de_superadmin"
