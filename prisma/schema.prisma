// Esquema oficial de Base de Datos — MuniEmprende San Roque
// Fuente de verdad conceptual: memory.md (Secciones 4 y 6)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [unaccent, pg_trgm]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ENTREPRENEUR
  MODERATOR
  ADMIN

  @@map("user_role")
}

enum EntrepreneurStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("entrepreneur_status")
}

enum ProductStatus {
  PENDING
  APPROVED
  PAUSED
  REJECTED
  SUSPENDED

  @@map("product_status")
}

enum AuditEntityType {
  USER
  ENTREPRENEUR
  PRODUCT
  CATEGORY

  @@map("audit_entity_type")
}

// ============================================================================
// MODELOS
// ============================================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(ENTREPRENEUR)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relaciones
  entrepreneur          Entrepreneur?
  approvedEntrepreneurs Entrepreneur[] @relation("EntrepreneurApprovedBy")
  approvedProducts      Product[]      @relation("ProductApprovedBy")
  auditLogs             AuditLog[]

  @@index([role, isActive])
  @@map("users")
}

model Entrepreneur {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  businessName    String             @map("business_name") @db.VarChar(150)
  slug            String             @unique @db.VarChar(180)
  ownerName       String             @map("owner_name") @db.VarChar(150)
  whatsappNumber  String             @map("whatsapp_number") @db.VarChar(25)
  neighborhood    String?            @db.VarChar(120)
  bio             String?            @db.Text
  avatarPath      String?            @map("avatar_path") @db.VarChar(255)
  status          EntrepreneurStatus @default(PENDING)
  rejectionReason String?            @map("rejection_reason") @db.Text
  approvedAt      DateTime?          @map("approved_at")
  approvedById    String?            @map("approved_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  // Relaciones
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver User?     @relation("EntrepreneurApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  products Product[]

  @@index([status])
  @@index([approvedById])
  @@index([businessName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("entrepreneurs")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  entrepreneurId    String        @map("entrepreneur_id") @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  title             String        @db.VarChar(160)
  slug              String        @unique @db.VarChar(200)
  description       String        @db.Text
  priceArs          Decimal?      @map("price_ars") @db.Decimal(12, 2)
  status            ProductStatus @default(PENDING)
  rejectionReason   String?       @map("rejection_reason") @db.Text
  lastPriceUpdateAt DateTime?     @map("last_price_update_at")
  expiresAt         DateTime?     @map("expires_at")
  approvedAt        DateTime?     @map("approved_at")
  approvedById      String?       @map("approved_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relaciones
  entrepreneur Entrepreneur   @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  approver     User?          @relation("ProductApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  images       ProductImage[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([entrepreneurId, status])
  @@index([categoryId, status])
  @@index([approvedById])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  relativePath String   @map("relative_path") @db.VarChar(255)
  width        Int
  height       Int
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relaciones
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model AuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  actorUserId String?         @map("actor_user_id") @db.Uuid
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id") @db.Uuid
  action      String          @db.VarChar(80)
  metadata    Json?           @db.JsonB
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relaciones
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
